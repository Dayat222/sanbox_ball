<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Status Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_stealth_shield"
            android:contentDescription="Shield" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEALTH SANDBOX ENGINE"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_app_version_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0.0-beta • Periksa Pembaruan"
                android:textColor="@color/stealth_cyan"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_shield_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_active"
            android:text="5/5 SHIELDS ACTIVE"
            android:textColor="@color/badge_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Active Hardware Identity Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IDENTITAS VIRTUAL AKTIF (TAMENG HWID)"
            android:textColor="@color/stealth_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_active_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="• Model: SAMSUNG SM-S928B"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txt_active_imei"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="• IMEI: 358941209847192"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txt_active_android_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="• Android ID: 4b2e8a109c5d7f3e"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txt_active_mac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="• MAC: 02:A1:B2:C3:D4:E5 (Fiber_Fast_5G)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- 1-Click Reset Button -->
        <Button
            android:id="@+id/btn_one_click_reset"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_danger"
            android:text="⚡ 1-CLICK RESET (NEW IDENTITY)"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Update Banner (Shown if update is available) -->
    <LinearLayout
        android:id="@+id/layout_update_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_stealth_shield"
            android:contentDescription="Update Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_update_banner_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pembaruan Baru Tersedia"
                android:textColor="@color/stealth_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_update_banner_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Klik untuk update langsung tanpa instal manual"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_banner_update"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_button_stealth"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="UPDATE"
            android:textColor="@color/bg_dark"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action Shortcuts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_open_cloner"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_stealth"
            android:text="+ KLONING APLIKASI"
            android:textColor="@color/bg_dark"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_open_profile"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:text="SPOOFER PROFIL"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Section Title: Cloned Apps -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"
        android:text="KONTAINER APLIKASI TERISOLASI"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/txt_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/no_apps_cloned"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <!-- Cloned Apps List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_cloned_apps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:visibility="gone" />
</LinearLayout>
